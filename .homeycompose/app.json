{
  "id": "com.lomohome.localthings",
  "version": "0.7.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "runtime": "python",
  "pythonVersion": "3.14",
  "pythonPackages": [
    "smartthings-local>=0.1.2"
  ],
  "platforms": [
    "local"
  ],
  "brandColor": "#1428A0",
  "name": {
    "en": "SmartThings Local",
    "ko": "스마트싱스 로컬"
  },
  "description": {
    "en": "Control Samsung appliances locally, with no cloud in between",
    "ko": "삼성 가전을 클라우드 없이, 로컬에서 바로 제어하세요"
  },
  "category": [
    "appliances"
  ],
  "tags": {
    "en": [
      "Samsung",
      "SmartThings",
      "local",
      "appliance",
      "air conditioner",
      "induction",
      "cooktop",
      "range hood",
      "refrigerator",
      "CoAP",
      "DTLS"
    ],
    "ko": [
      "삼성",
      "스마트싱스",
      "로컬제어",
      "가전",
      "에어컨",
      "인덕션",
      "쿡탑",
      "주방후드",
      "후드",
      "냉장고",
      "변온고",
      "비스포크"
    ]
  },
  "permissions": [],
  "api": {
    "get_status": {
      "method": "GET",
      "path": "/status"
    },
    "check_uuid": {
      "method": "GET",
      "path": "/check-uuid"
    },
    "save_credentials": {
      "method": "POST",
      "path": "/credentials"
    },
    "mint_credentials": {
      "method": "POST",
      "path": "/credentials-mint"
    },
    "clear_credentials": {
      "method": "POST",
      "path": "/credentials-clear"
    },
    "diagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "resources": {
      "method": "GET",
      "path": "/resources"
    },
    "read_resource": {
      "method": "POST",
      "path": "/read-resource"
    },
    "write_resource": {
      "method": "POST",
      "path": "/write-resource"
    },
    "set_language": {
      "method": "POST",
      "path": "/language"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Geunwon Mo",
    "email": "mokorean@gmail.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Geunwon Mo",
        "email": "mokorean@gmail.com"
      },
      {
        "name": "Marc Billow"
      },
      {
        "name": "Jack Nagy"
      }
    ]
  },
  "copyright": "Geunwon Mo (mokorean@gmail.com). Appliance resource model ported from the LocalThings Home Assistant integration by Marc Billow, and DTLS-CoAP transport by Jack Nagy, both MIT-licensed. See NOTICE.",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/moKorean/com.lomohome.localthings/issues"
  },
  "support": "https://github.com/moKorean/com.lomohome.localthings/blob/main/docs/CA-SETUP.en.md",
  "source": "https://github.com/moKorean/com.lomohome.localthings"
}
