  },
  "titleFormatted": {
    "en": "Set Target humidity to [[value]]",
    "ko": "목표 습도 설정: [[value]]"
  },
  "hint": {
    "en": "Fails the Flow if the appliance refuses the change, rather than reporting a success it did not achieve.",
    "ko": "가전이 변경을 거부하면 플로우를 실패로 처리합니다. 이루지 못한 성공을 보고하지 않습니다."
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=appliance&capabilities=localthings_target_humidity"
    },
    {
      "name": "value",
      "type": "number",
      "min": 30,
      "max": 70,
      "step": 5
    }
  ]
